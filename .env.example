BOT_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///./queue_bot.db
LOG_LEVEL=INFO
# One hour to claim a place offered from the queue.
OFFER_TTL_SECONDS=3600
ADMIN_IDS=
# true: a user may occupy different proxies at the same time.
ALLOW_MULTIPLE_PROXIES=true
# Ask an active user to confirm their session every 3 hours; release it after 10 minutes without a reply.
SESSION_CONFIRMATION_INTERVAL_SECONDS=10800
SESSION_CONFIRMATION_GRACE_SECONDS=600


